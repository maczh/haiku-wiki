# ===== 海库（haiku-wiki）环境变量示例 =====
# 复制为 .env（docker compose 自动读取）或直接注入容器环境变量。

# HTTP 监听端口
PORT=8080

# 数据库驱动：sqlite（默认，零配置）| mysql
DB_DRIVER=sqlite

# 数据库连接串
#   sqlite：默认 DATA_DIR/haiku.db，无需配置（可留空）
#   mysql 示例：user:password@tcp(127.0.0.1:3306)/haiku?charset=utf8mb4&parseTime=True&loc=Local
DB_DSN=

# JWT 签名密钥 —— 生产环境必须改成随机长字符串！
JWT_SECRET=haiku-wiki-dev-secret-change-me

# 数据目录（SQLite 文件与 uploads/ 根目录；容器内固定为 /app/data）
DATA_DIR=./data

# Gin 运行模式：debug | release
GIN_MODE=debug
