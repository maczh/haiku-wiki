# 依赖与构建产物
node_modules/
tools/
web/dist/
# Vditor 自托管静态资源（由 web/scripts/copy-vditor-assets.mjs 生成，勿手动提交）
web/public/vditor/
# draw.io 自托管绘图组件（约 44MB 第三方静态资源，勿提交）
#   web/vendor/drawio    —— 由 web/scripts/fetch-drawio-assets.mjs 按白名单拉取的原始资源
#   web/public/drawio    —— 由 web/scripts/copy-drawio-assets.mjs 同步的构建输入
# 两者都可在 `npm run fetch:drawio`（或 npm run dev/build 的前置脚本）中自动重建。
web/vendor/drawio/
web/public/drawio/
# Excalidraw 自托管字体/语言包（由 web/scripts/copy-excalidraw-assets.mjs 同步，勿手动提交）
web/public/excalidraw/
# 嵌入用的前端产物（由 web/dist 拷贝进来，见 Dockerfile；保留占位文件 .gitkeep）
server/internal/static/dist/*
!server/internal/static/dist/.gitkeep
.Trash-0/

# 运行数据
data/
*.db
*.db-shm
*.db-wal
# 例外：回归套件的数据夹具。tools/verify/fixtures/e2e-data 是种子库快照
# （ui-doc-types / ui-shot / check-lazy-routes / check-route-fallback 依赖它，
#   套件每次复制成临时副本再用），必须随仓库分发，否则套件无法复现。
!tools/verify/fixtures/**/*.db

# 环境变量（含密钥，禁止入库）
.env

# IDE / 系统
.idea/
.vscode/
.DS_Store

# Python 字节码（tools/templates/*.py 会被反复执行）
__pycache__/
*.pyc

# 容器镜像导出物（`docker save` 产出，约 180MB，绝不入库）
*.tar

# Vite 配置探测残留（dev/build 中断时可能落在 web/ 下，属临时文件，勿提交）
web/vite.config.ts.timestamp-*.mjs
